# Copy to .env.server ONLY for the local gateway. Ignored by git.
# Default is fully offline; keep it until the review in docs/m3-local-gateway.md is done.
DATA_MODE=sample
FOOTBALL_API_KEY=
FOOTBALL_FREE_PLAN_CONFIRMED=false
# Reference to your dated review/permission record, not a key. Empty keeps gateway disabled.
FOOTBALL_RIGHTS_REVIEW=
# Never create VITE_FOOTBALL_API_KEY or paste keys in chats, issues or source files.
